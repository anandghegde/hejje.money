# Copy to deploy/.env on the VM. Never commit the real file.
HEJJE_DOMAIN=hejje.example.com
POSTGRES_PASSWORD=change-me

# Execution mode: PAPER | CONFIRM | AUTO (CONFIRM/AUTO only start with the prod profile)
HEJJE_MODE=PAPER

# First-start bootstrap password for the 'admin' user (only read while no user exists)
HEJJE_ADMIN_PASSWORD=change-me
# At least 32 random bytes, e.g. openssl rand -base64 48
HEJJE_JWT_SECRET=change-me-change-me-change-me-change-me
# AES-GCM key for broker tokens at rest (Phase 1), e.g. openssl rand -base64 32
HEJJE_ENCRYPTION_KEY=

# Static egress IP(s) registered with Zerodha, comma separated
HEJJE_EXECUTION_EXPECTED_IPS=203.0.113.10
