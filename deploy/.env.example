# Copy to deploy/.env on the VM. Never commit the real file.
HEJJE_DOMAIN=hejje.example.com
POSTGRES_PASSWORD=change-me

# --- execution mode -------------------------------------------------------------------------------
# PAPER | CONFIRM | AUTO. CONFIRM/AUTO only start under the prod profile (the compose sets it) and
# require the static IP below to be registered with Zerodha. Start with PAPER for the first deploy.
HEJJE_MODE=PAPER

# --- auth and secrets -----------------------------------------------------------------------------
# First-start bootstrap password for the 'admin' user (only read while no user exists)
HEJJE_ADMIN_PASSWORD=change-me
# HS256 JWT secret, at least 32 bytes, e.g. openssl rand -base64 48
HEJJE_JWT_SECRET=change-me-change-me-change-me-change-me
# AES-GCM key for broker tokens at rest, 32 bytes base64 or hex, e.g. openssl rand -base64 32
HEJJE_ENCRYPTION_KEY=

# --- broker ---------------------------------------------------------------------------------------
# fake (no real broker) or zerodha (live data + real/paper orders)
HEJJE_BROKER_ADAPTER=zerodha
# Kite Connect app credentials (developers.kite.trade). Redirect URL for the app:
#   https://${HEJJE_DOMAIN}/api/v1/broker/callback
HEJJE_KITE_API_KEY=
HEJJE_KITE_API_SECRET=
# Where the broker login callback redirects the browser after connecting
HEJJE_WEB_URL=https://hejje.example.com

# --- market data ----------------------------------------------------------------------------------
# Stream live ticks on startup once the broker session is connected
HEJJE_MARKET_STREAM=true
# Record ticks to ${data-dir}/ticks for replay (optional)
HEJJE_MARKET_RECORD=false

# --- static IP verification (SEBI/NSE) ------------------------------------------------------------
# The VM's public egress IP(s), comma separated, registered with Zerodha. Live execution is blocked
# unless the server's observed egress IP is one of these.
HEJJE_EXECUTION_EXPECTED_IPS=203.0.113.10
